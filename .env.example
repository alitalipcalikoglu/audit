# --- Server ---
PORT=3005
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Largest request body; a batch of 500 events with 8 KiB metadata each needs about 4 MiB.
BODY_LIMIT=1048576

# --- Storage ---
DB_PATH=./data/audit.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
# Events received longer ago than this are deleted; a chain checkpoint keeps the rest verifiable.
RETENTION_DAYS=365

# --- Callers: id:secret[:role], comma separated. The id is recorded as the event's "source".
# Roles: write (services that only push), read (dashboards, exporters), readwrite (default).
# Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
AUDIT_API_KEYS=auth:REPLACE_WITH_64_HEX_CHARS:write,shop-backend:REPLACE_WITH_64_HEX_CHARS:write,console:REPLACE_WITH_64_HEX_CHARS:read
# Requests per key per minute.
RATE_LIMIT_MAX=1200

# --- Ingest limits ---
MAX_BATCH=500
# Canonical JSON size of one event's meta after redaction.
META_MAX_BYTES=8192
# Client "at" may be at most this far in the future.
CLOCK_SKEW_SEC=300
# Meta keys whose values are replaced by "[REDACTED]"; matching ignores case, "_" and "-".
# Leave empty for the built-in list; "-" disables redaction.
REDACT_KEYS=

# --- Read limits ---
EXPORT_MAX_ROWS=100000
VERIFY_MAX_ROWS=100000

# --- Chain anchors (optional): signed periodic checkpoints of the chain head. Generate the key
# pair with: npm run anchor-keygen. Leave ANCHOR_PRIVATE_KEY_PATH empty to disable entirely — every
# other feature works identically without it.
ANCHOR_PRIVATE_KEY_PATH=
# During rotation: public key of the previous pair, so anchors it signed keep verifying.
ANCHOR_PREVIOUS_PUBLIC_KEY_PATH=
ANCHOR_INTERVAL_MIN=60
# Optional: also POST each anchor to an external URL, best-effort (never blocks or invalidates the
# anchor, which is recorded locally first regardless). Read "External anchoring" in README.md
# before relying on this for anything — it is not automatically an independent trust boundary.
ANCHOR_WEBHOOK_URL=
ANCHOR_WEBHOOK_TIMEOUT_MS=5000
# Same SSRF-guard shape as scheduler/webhook-out, for ANCHOR_WEBHOOK_URL.
TARGET_ALLOW_HTTP=false
TARGET_ALLOW_PRIVATE=false
TARGET_ALLOWED_HOSTS=

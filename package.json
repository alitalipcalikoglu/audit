{
  "name": "@atc-web/audit",
  "version": "1.0.0",
  "private": true,
  "description": "Central append-only audit log: services push events over HTTP, the log keeps a tamper-evident hash chain, offers filtered queries, export and retention",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/audit.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "anchor-keygen": "node scripts/anchor-keygen.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@atc-web/service-core": "github:alitalipcalikoglu/service-core#31c0d4819e3c54a209569437b5e5a00142eb5486",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
